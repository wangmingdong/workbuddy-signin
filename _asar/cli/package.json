  "scripts": {
    "lint": "genie-component lint --increase",
    "build": "genie-component build",
    "compile": "genie-component compile",
    "watch": "genie-component watch",
    "clean": "genie-component clean && rimraf dist",
    "test": "cross-env TS_NODE_PROJECT=tsconfig.tsnode.json node ../../dev-packages/component/scripts/run-mocha.js --require ts-node/register --config ../../dev-packages/component/configs/mocharc.yml --parallel=false \"./src/**/*.spec.ts\" --ignore \"./src/e2e/**\"",
    "test:e2e": "yarn package:all && cross-env TS_NODE_PROJECT=tsconfig.tsnode.json node ../../dev-packages/component/scripts/run-mocha.js --require ts-node/register --parallel=false --timeout 60000 \"./src/e2e/**/*.spec.ts\"",
    "build:web-ui": "cd src/node/remote-gateway/web-ui && cross-env NODE_OPTIONS=--no-deprecation yarn install --force --frozen-lockfile && cross-env NODE_OPTIONS=--no-deprecation yarn build && cd ../../../.. && node scripts/build-docs.js && node scripts/generate-webui-embed.js",
    "build:builtin-embed": "node scripts/generate-builtin-embed.js",
    "patch": "concurrently \"npx genie patch -s ../../build/patches/cli-saas .\" \"npx genie patch -s ../../build/patches/cli-saas/product.internal.json -n product.internal.json .\" \"npx genie patch -s ../../build/patches/cli-saas/product.ioa.json -n product.ioa.json .\" \"npx genie patch -s ../../build/patches/cli-saas/product.cloudhosted.json -n product.cloudhosted.json .\" \"npx genie patch -s ../../build/patches/cli-saas/product.selfhosted.json -n product.selfhosted.json .\"",
    "package": "yarn run build:builtin-embed && yarn run patch && cross-env USE_RSPACK=1 CELL_PROJECT_HOME_PATH=dist cell build -m externals -p",
    "package:headless": "yarn run build:builtin-embed && yarn run patch && cross-env USE_RSPACK=1 CELL_PROJECT_HOME_PATH=dist cell build -m externals,headless -p",
    "package:standalone": "yarn run package && goreleaser release --snapshot --clean",
    "package:all": "yarn run build:builtin-embed && yarn run patch && cross-env USE_RSPACK=1 CELL_PROJECT_HOME_PATH=dist cell build -m externals -p && cross-env USE_RSPACK=1 CELL_PROJECT_HOME_PATH=.dist-headless cell build -m externals,headless -p && node -e \"require('fs').cpSync('.dist-headless/codebuddy-headless.js','dist/codebuddy-headless.js');require('fs').rmSync('.dist-headless',{recursive:true,force:true})\" && yarn run build:web-ui",
    "package:standalone-all": "yarn run package:all && goreleaser release --snapshot --clean",
    "dev": "yarn run patch && cross-env CELL_PROJECT_HOME_PATH=dist cell serve -m externals",
    "dev-proxy": "cross-env HTTP_PROXY=http://localhost:8899 HTTPS_PROXY=http://localhost:8899 NODE_TLS_REJECT_UNAUTHORIZED=0 yarn dev",
    "start": "yarn run package && node bin/codebuddy",
    "start-proxy": "yarn run package && cross-env HTTP_PROXY=http://localhost:8899 HTTPS_PROXY=http://localhost:8899 node bin/codebuddy",
    "serve": "node bin/codebuddy --serve",
    "serve:port": "node bin/codebuddy --serve --port 3000",
    "changeset": "changeset",
    "changeset:merge": "changeset version && git checkout package.json",
    "prepublishOnly": "yarn run package:all && genie-component prepublishOnly",
    "afterInstall": "patch-package"
  },
  "devDependencies": {
    "@celljs/cli": "3.7.8",
