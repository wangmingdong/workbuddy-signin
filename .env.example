# ===== 本地运维配置模板（提交到仓库，供他人照填）=====
# 复制本文件为 `.env` 并填入你自己的真实值；`.env` 已被 .gitignore 忽略，不会入库。

# --- ECS 服务器（check_112_hw / build_center_preview / hw_watch_login /
#     hw_autopush / install_hw_keepalive 等 SSH 运维脚本用）---
ECS_HOST=SERVER_IP_112
ECS_PORT=22
ECS_USER=root
ECS_PASS=your_ecs_root_password

# --- 网页签到中心访问口令（check_now.py 用；对应服务器 WB_ACCESS_KEY）---
# 手机首次访问页面需输入一次。生产环境由 systemd service 的 WB_ACCESS_KEY 注入。
ACCESS_KEY=your_page_access_key
