# ===== 本地运维配置模板（提交到仓库，供他人照填）=====
# 复制本文件为 `.env` 并填入你自己的真实值；`.env` 已被 .gitignore 忽略，不会入库。

# --- 云服务器（SSH 运维脚本用：hw_watch_login / hw_autopush / install_hw_keepalive ...）---
# 自部署时改成你自己的服务器地址与账号
ECS_HOST=your_server_ip
ECS_PORT=22
ECS_USER=root
ECS_PASS=your_ecs_root_password

# --- 网页签到中心访问口令（对应服务器 WB_ACCESS_KEY）---
# 手机首次访问页面需输入一次。生产环境由 systemd service 的 WB_ACCESS_KEY 注入。
ACCESS_KEY=your_page_access_key

# --- WorkBuddy 明文令牌同步（wb_token_sync.py 用）---
# 服务器上 token.info 的落盘路径；一般无需改动。
# WB_REMOTE_TOKEN_PATH=/opt/wb-checkin/token.info
# SFTP 不通时的 HTTP 兜底通道（走 nginx 的 /checkin/），按需填写。
# WB_REMOTE_HTTP=https://your_domain/checkin
# 注意：wb_token_sync.py 早先把上面这些值硬编码在源码里，会导致服务器 root 密码
# 随仓库外泄。现已改为只从环境变量读取，请勿再写回源码。

# --- 本机可执行文件路径（可选；脚本会自动探测，探测失败时再显式指定）---
# WorkBuddy 主程序（wb_token_sync.py 自动发现在常见安装目录与盘符根下）
# WORKBUDDY_EXE=C:\path\to\WorkBuddy.exe
# Python / Node 解释器（bat 脚本默认优先 WorkBuddy 自带，其次系统 PATH）
# PYTHON_PATH=C:\path\to\python.exe
# NODE_EXE=C:\path\to\node.exe
# Playwright 模块目录（doubao/trae 采集脚本使用系统 Edge；需要指定时填）
# PLAYWRIGHT_CORE_PATH=C:\path\to\node_modules\playwright-core

# --- 各平台凭据（环境变量优先于同名本地文件；文件已在 .gitignore 忽略）---
# 以下变量全部留空即可，改用「同目录本地文件」方式提供（见 README「配置各平台凭据」）。
# WorkBuddy：本地 token 文件路径（默认 BASE_DIR/token.info）
# WB_TOKEN_FILE=token.info
# 千帆
# QF_ACCESS_TOKEN=你的千帆AccessToken
# QF_BASE_URL=http://你的千帆服务/checkin
# MiniMax Code
# MM_WEB_TOKEN=你的MiniMax网页JWT
# Qoder
# QODER_TOKEN=你的QoderToken
# QODER_BASE_URL=https://openapi.qoder.sh
# Link AI
# LINKAI_TOKEN=你的LinkAI Token
# WPS 灵犀（Cookie 串，name=val; 分号分隔）
# LX_COOKIE=name1=val1; name2=val2
# Trae Work（Cookie 串优先；TRAE_JWT 为可选短期 JWT；TRAE_DEVICE_ID 必填你的客户端真实设备 id）
# TRAE_COOKIE=name1=val1; name2=val2
# TRAE_JWT=短期JWT
# TRAE_DEVICE_ID=你的Trae客户端真实设备id（从 storage.json 键名 iCubeAuthInfo://icube-dc:<id> 或客户端日志 device_id= 取；留空则 Trae 签到必 9074）
# 华为码道（Cookie 串，name=val; 分号分隔）
# HW_COOKIE=name1=val1; name2=val2
